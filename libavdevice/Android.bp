// SPDX-License-Identifier: LGPL-2.1-or-later
//
// Operit fork 增补：dvab 上游缺 libavfilter/libavdevice 的 Android.bp（源在树）。
// 源集由 Makefile OBJS 规则 + config 旗标推导（tools 侧脚本生成）——
// 裸 glob 会误收 *_template.c 碎片与外部库滤镜（pocketsphinx/zimg/whisper 等）。
//

cc_library_shared {
    name: "libavdevice",
    defaults: ["ffmpeg_defaults"],
    shared_libs: [
"libavutil",
        "libavcodec",
        "libavformat",
    ],
    srcs: [
        "alldevices.c",
        "avdevice.c",
        "utils.c",
        "version.c",
    ],
}
